# --- Runtime (read by the proxy at request time) ---

# Which SaaS this Cloud Run service exposes. One of: miro, figma, lucid.
ACTIVE_PROVIDER=miro

# Restrict CORS to Gemini Enterprise in production. Comma-separated for multiple.
ALLOWED_ORIGINS=https://vertexaisearch.cloud.google.com

# Cloud Run injects PORT; keep as 8080 locally.
PORT=8080

# --- Deploy-time (read by scripts/deploy-*.sh, NOT by the proxy) ---

# GCP project to deploy into. Required.
PROJECT=

# Optional overrides:
# REGION=us-central1
# SERVICE_NAME=mcp-miro-passthrough
