# Which SaaS this Cloud Run service exposes. One of: miro, figma, lucid.
ACTIVE_PROVIDER=miro

# Inbound identity (Gemini Enterprise's OAuth client registered with your IdP).
GOOGLE_CLIENT_ID=

# Production: set to your GCP project to use Firestore. Leave blank for local JSON dev store.
GCP_PROJECT_ID=

# Restrict CORS to Gemini Enterprise in production.
ALLOWED_ORIGINS=https://vertexaisearch.cloud.google.com

# Cloud Run injects PORT; keep as 8080 locally.
PORT=8080

# --- Miro ---
MIRO_CLIENT_ID=
MIRO_CLIENT_SECRET=
MIRO_REDIRECT_URI=https://YOUR-CLOUD-RUN-URL/auth/miro/callback

# --- Figma ---
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=https://YOUR-CLOUD-RUN-URL/auth/figma/callback

# --- Lucid ---
LUCID_CLIENT_ID=
LUCID_CLIENT_SECRET=
LUCID_REDIRECT_URI=https://YOUR-CLOUD-RUN-URL/auth/lucid/callback
